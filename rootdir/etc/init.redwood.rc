service vendor.nfc_hal_service /vendor/bin/hw/android.hardware.nfc-service.nxp
    override
    class early_hal
    user nfc
    group nfc drmrpc system
    disabled

service qti_esepowermanager_service_1_1 /vendor/bin/hw/vendor.qti.esepowermanager@1.1-service
    override
    class hal
    user system
    group nfc system
    disabled

service secureelement-hal_1_2 /vendor/bin/hw/vendor.qti.secure_element@1.2-service
    override
    class hal
    user system
    group system
    disabled

on property:ro.boot.product.hardware.sku=redwood
    enable vendor.nfc_hal_service
    enable qti_esepowermanager_service_1_1
    enable secureelement-hal_1_2

# hardware/dolby sets debug.c2.use_dmabufheaps=1. 6.12 has the system
# DMA-BUF heap that 5.4 lacked, so Codec2 then gives up ION, which the
# 32-bit QTI codecs need for their buffers, and no video plays. Keep ION.
on early-boot
    setprop debug.c2.use_dmabufheaps 0

on boot
    # The charger driver registers the usb power supply after the health HAL
    # has started, and the HAL only looks for chargers when it starts, so USB
    # charging showed as neither USB nor AC. Restart it once the supply is up.
    wait /sys/class/power_supply/usb/type
    restart vendor.health-default
